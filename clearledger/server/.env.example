# ClearLedger Server — переменные окружения
# Скопируйте в .env и настройте значения для production.
# При запуске через docker-compose из корня — .env не нужен, всё настроено.

DATABASE_URL=postgresql+asyncpg://clearledger:clearledger@localhost:5432/clearledger

# SECRET_KEY используется для JWT и для симметричного шифрования паролей
# подключений к 1С (services/onec/crypto.py). Сгенерируйте через
# `openssl rand -hex 32` — при ротации все сохранённые пароли 1С
# инвалидируются, потребуется ввести заново.
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
OCR_ENABLED=true

# Суперадмин при первом старте создаётся ТОЛЬКО если заданы обе переменные.
# Пусто (по умолчанию) — суперадмин на старте не создаётся (нет бэкдора).
# Создав суперадмина один раз, уберите эти переменные из окружения.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
