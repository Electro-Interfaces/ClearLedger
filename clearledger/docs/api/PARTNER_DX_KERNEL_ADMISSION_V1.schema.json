        "controller_net",
        "controller_pid",
        "controller_ipc",
        "controller_user",
        "controller_time",
        "mountinfo_sha256"
      ],
      "properties": {
        "mnt": {
          "$ref": "#/$defs/D"
        },
        "net": {
          "$ref": "#/$defs/D"
        },
        "pid": {
          "$ref": "#/$defs/D"
        },
        "ipc": {
          "$ref": "#/$defs/D"
        },
        "user": {
          "$ref": "#/$defs/D"
        },
        "time": {
          "$ref": "#/$defs/D"
        },
        "controller_mnt": {
          "$ref": "#/$defs/D"
        },
        "controller_net": {
          "$ref": "#/$defs/D"
        },
        "controller_pid": {
          "$ref": "#/$defs/D"
        },
        "controller_ipc": {
          "$ref": "#/$defs/D"
        },
        "controller_user": {
          "$ref": "#/$defs/D"
        },
        "controller_time": {
          "$ref": "#/$defs/D"
        },
        "mountinfo_sha256": {
          "$ref": "#/$defs/H"
        }
      }
    },
    "Mount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "mount_id",
        "major",
        "minor",
        "root",
        "mount_point",
        "fs_type",
        "read_only",
        "owner_uid",
        "owner_gid",
        "mode"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "rootfs",
            "source",
            "native_runtime",
            "venv",
            "policy",
            "admission",
            "cache",
            "work_pool",
            "cwd",
            "upload",
            "evidence",
            "scratch"
          ]
        },
        "path": {
          "$ref": "#/$defs/P"
        },
        "mount_id": {
          "$ref": "#/$defs/N"
        },
        "major": {
          "$ref": "#/$defs/N"
        },
        "minor": {
          "$ref": "#/$defs/N"
        },
        "root": {
          "$ref": "#/$defs/P"
        },
        "mount_point": {
          "$ref": "#/$defs/P"
        },
        "fs_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[\\u0000-\\u007f]*$(?![\\s\\S])"
        },
        "read_only": {
          "$ref": "#/$defs/Bool"
        },
        "owner_uid": {
          "$ref": "#/$defs/N"
        },
        "owner_gid": {
          "$ref": "#/$defs/N"
        },
        "mode": {
          "$ref": "#/$defs/O"
        }
      }
    },
    "Quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pool_mount_id",
        "max_bytes",
        "max_inodes",
        "max_regular_entries",
        "file_max_bytes",
        "hardlinks"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "shared-tmpfs-v1"
        },
        "pool_mount_id": {
          "$ref": "#/$defs/N"
        },
        "max_bytes": {
          "type": "integer",
          "const": 67108864
        },
        "max_inodes": {
          "type": "integer",
          "const": 133
        },
        "max_regular_entries": {
          "type": "integer",
          "const": 128
        },
        "file_max_bytes": {
          "type": "integer",
          "const": 16777216
        },
        "hardlinks": {
          "type": "string",
          "const": "DENY_KERNEL_POLICY"
        }
      }
    },
    "HostFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold_bytes",
        "before",
        "monitor_interval_ms",
        "max_sample_gap_ms",
        "on_failure",
        "after_required"
      ],
      "properties": {
        "threshold_bytes": {
          "type": "integer",
          "const": 8589934592
        },
        "before": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/HostSample"
          }
        },
        "monitor_interval_ms": {
          "type": "integer",
          "const": 1000
        },
        "max_sample_gap_ms": {
          "type": "integer",
          "const": 1500
        },
        "on_failure": {
          "type": "string",
          "const": "KILL_AND_REJECT"
        },
        "after_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "HostSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_id",
        "measured_ms",
        "free_bytes"
      ],
      "properties": {
        "storage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\u0000-\\u007f]*$(?![\\s\\S])"
        },
        "measured_ms": {
          "$ref": "#/$defs/N"
        },
        "free_bytes": {
          "$ref": "#/$defs/N"
        }
      }
    },
    "Controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "euid",
        "policy_path",
        "admission_sealed",
        "kernel_policy_loaded",
        "external_watchdog_armed",
        "wall_ms",
        "stdout_stderr_max_bytes",
        "cpu_hard_seconds",
        "memory_max_bytes",
        "file_hard_bytes",
        "fd_hard_limit",
        "pids_max"
      ],
      "properties": {
        "euid": {
          "$ref": "#/$defs/N"
        },
        "policy_path": {
          "type": "string",
          "const": "/inputs/policy/execute-policy.json"
        },
        "admission_sealed": {
          "type": "boolean",
          "const": true
        },
        "kernel_policy_loaded": {
          "type": "boolean",
          "const": true
        },
        "external_watchdog_armed": {
          "type": "boolean",
          "const": true
        },
        "wall_ms": {
          "type": "integer",
          "const": 180000
        },
        "stdout_stderr_max_bytes": {
          "type": "integer",
          "const": 8388608
        },
        "cpu_hard_seconds": {
          "type": "integer",
          "const": 150
        },
        "memory_max_bytes": {
          "type": "integer",
          "const": 2147483648
        },
        "file_hard_bytes": {
          "type": "integer",
          "const": 16777216
        },
        "fd_hard_limit": {
          "type": "integer",
          "const": 96
        },
        "pids_max": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "F": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "phase",
        "clock",
        "nonce",
        "admission_sha256",
        "policy_sha256",
        "runner_sha256",
        "source_head",
        "exit_code",
        "termination_signal",
        "host_floor",
        "output_bytes",
        "artifacts_manifest_sha256",
        "source_before_sha256",
        "source_after_sha256",
        "runtime_before_sha256",
        "runtime_after_sha256",
        "decision"
      ],
      "properties": {
        "format": {
          "type": "string",
          "const": "elsy.partner-dx.kernel-final.v1"
        },
        "phase": {
          "type": "string",
          "const": "FINAL"
        },
        "clock": {
          "type": "string",
          "const": "CLOCK_MONOTONIC_MS"
        },
        "nonce": {
          "$ref": "#/$defs/H"
        },
        "admission_sha256": {
          "$ref": "#/$defs/H"
        },
        "policy_sha256": {
          "$ref": "#/$defs/H"
        },
        "runner_sha256": {
          "$ref": "#/$defs/H"
        },
        "source_head": {
          "$ref": "#/$defs/G"
        },
        "exit_code": {
          "$ref": "#/$defs/N"
        },
        "termination_signal": {
          "$ref": "#/$defs/N"
        },
        "host_floor": {
          "$ref": "#/$defs/FinalHostFloor"
        },
        "output_bytes": {
          "$ref": "#/$defs/N"
        },
        "artifacts_manifest_sha256": {
          "$ref": "#/$defs/H"
        },
        "source_before_sha256": {
          "$ref": "#/$defs/H"
        },
        "source_after_sha256": {
          "$ref": "#/$defs/H"
        },
        "runtime_before_sha256": {
          "$ref": "#/$defs/H"
        },
        "runtime_after_sha256": {
          "$ref": "#/$defs/H"
        },
        "decision": {
          "type": "string",
          "enum": [
            "SAFETY_ACCEPTED",
            "REJECTED"
          ]
        }
      },
      "description": "External controller ONLY; candidate never emits or accepts F as its own proof. Same nonce and raw admission SHA required. External semantics require matching storage IDs, all physical before/during/after >=8589934592, samples>=1, gap<=1500ms, output<=8388608, unchanged source/runtime, valid exit/signal, all independent controls; otherwise REJECTED. Normal termination_signal=0 and exit_code=0..255; signal=1..64 requires exit_code=128+signal and REJECTED."
    },
    "FinalHostFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_results",
        "status"
      ],
      "properties": {
        "storage_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/StorageResult"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "StorageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_id",
        "before_free",
        "minimum_observed_during_free",
        "after_free",
        "samples",
        "max_gap_ms"
      ],
      "properties": {
        "storage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\u0000-\\u007f]*$(?![\\s\\S])"
        },
        "before_free": {
          "$ref": "#/$defs/N"
        },
        "minimum_observed_during_free": {
          "$ref": "#/$defs/N"
        },
        "after_free": {
          "$ref": "#/$defs/N"
        },
        "samples": {
          "$ref": "#/$defs/N"
        },
        "max_gap_ms": {
          "$ref": "#/$defs/N"
        }
      }
    },
    "N": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "Bool": {
      "type": "boolean"
    },
    "H": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
    },
    "G": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40})$(?![\\s\\S])"
    },
    "D": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*)$(?![\\s\\S])"
    },
    "O": {
      "type": "string",
      "pattern": "^(?:[0-7]{4})$(?![\\s\\S])"
    },
    "P": {
      "type": "string",
      "pattern": "^(?:/[A-Za-z0-9._/-]*)$(?![\\s\\S])",
      "allOf": [
        {
          "not": {
            "pattern": "//"
          }
        },
        {
          "not": {
            "pattern": "/\\.{1,2}(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "/.+/$"
          }
        }
      ],
      "description": "Absolute normalized POSIX path; runtime must also reject symlinks in every component, without rewriting input."
    },
    "Branch": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9._/-]{1,200})$(?![\\s\\S])"
    },
    "Image": {
      "type": "string",
      "pattern": "^(?:sha256:[0-9a-f]{64})$(?![\\s\\S])"
    }
  },
