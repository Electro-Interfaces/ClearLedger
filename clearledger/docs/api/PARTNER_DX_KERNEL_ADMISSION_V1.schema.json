{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elsy:partner-dx:kernel-admission:v1",
  "title": "Partner DX kernel admission and external final v1 (SOURCE ONLY / NOTRUN)",
  "$comment": "NOTREAL: Both complete examples are pure fiction, not host measurements, receipts, control execution or acceptance. Runtime remains 0; ROOT kernel implementation and real capability UNKNOWN/NOTRUN; F9/F10 PARTIAL/HOLD. This schema is outside frozen API/schema trees.",
  "description": "Byte protocol: ASCII json.dumps(ensure_ascii=True,sort_keys=True,separators=(comma,colon),allow_nan=False) plus exactly one LF, <=65536 raw bytes including LF; raw SHA includes LF. Reject BOM, duplicate keys, floats/NaN/Infinity, noncanonical integers and extra bytes before schema validation. All fields required; unknown fields forbidden. Schema checks shape only: kernel observations, independent pins, namespace identity, RO/ownership, quota and controller final relations are additional mandatory checks. Candidate outcome is EXTERNAL_FINAL_PENDING until trusted external F. Clock is CLOCK_MONOTONIC_MS, including all HostSample.measured_ms, startup issued/expires, watchdog 180000ms and monitoring gaps; time/controller_time must equal actual /proc/self/ns/time.",
  "oneOf": [
    {
      "$ref": "#/$defs/A"
    },
    {
      "$ref": "#/$defs/F"
    }
  ],
  "$defs": {
    "A": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "phase",
        "clock",
        "nonce",
        "issued_ms",
        "expires_ms",
        "candidate",
        "bindings",
        "namespaces",
        "mounts",
        "quota",
        "host_floor",
        "controller"
      ],
      "properties": {
        "format": {
          "type": "string",
          "const": "elsy.partner-dx.kernel-admission.v1"
        },
        "phase": {
          "type": "string",
          "const": "ADMISSION"
        },
        "clock": {
          "type": "string",
          "const": "CLOCK_MONOTONIC_MS"
        },
        "nonce": {
          "$ref": "#/$defs/H"
        },
        "issued_ms": {
          "$ref": "#/$defs/N"
        },
        "expires_ms": {
          "$ref": "#/$defs/N"
        },
        "candidate": {
          "$ref": "#/$defs/Candidate"
        },
        "bindings": {
          "$ref": "#/$defs/Bindings"
        },
        "namespaces": {
          "$ref": "#/$defs/Namespaces"
        },
        "mounts": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/Mount"
          }
        },
        "quota": {
          "$ref": "#/$defs/Quota"
        },
        "host_floor": {
          "$ref": "#/$defs/HostFloor"
        },
        "controller": {
          "$ref": "#/$defs/Controller"
        }
      },
      "description": "External sealed startup admission only; never evidence of future monitoring or final safety acceptance. All millisecond fields use CLOCK_MONOTONIC in the same time namespace as the controller."
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "gid",
        "supplementary_gids",
        "home",
        "no_new_privs",
        "seccomp_mode",
        "cap_inh",
        "cap_prm",
        "cap_eff",
        "cap_bnd",
        "cap_amb"
      ],
      "properties": {
        "uid": {
          "$ref": "#/$defs/N"
        },
        "gid": {
          "$ref": "#/$defs/N"
        },
        "supplementary_gids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/N"
          }
        },
        "home": {
          "$ref": "#/$defs/P"
        },
        "no_new_privs": {
          "type": "integer",
          "const": 1
        },
        "seccomp_mode": {
          "type": "integer",
          "const": 2
        },
        "cap_inh": {
          "type": "string",
          "const": "0000000000000000"
        },
        "cap_prm": {
          "type": "string",
          "const": "0000000000000000"
        },
        "cap_eff": {
          "type": "string",
          "const": "0000000000000000"
        },
        "cap_bnd": {
          "type": "string",
          "const": "0000000000000000"
        },
        "cap_amb": {
          "type": "string",
          "const": "0000000000000000"
        }
      }
    },
    "Bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_sha256",
        "source_head",
        "source_branch",
        "app_sha256",
        "tests_sha256",
        "migrations_sha256",
        "support_sha256",
        "native_site_sha256",
        "versions_sha256",
        "prepared_cache_sha256",
        "policy_sha256",
        "controller_sha256",
        "image_digest"
      ],
      "properties": {
        "runner_sha256": {
          "$ref": "#/$defs/H"
        },
        "source_head": {
          "$ref": "#/$defs/G"
        },
        "source_branch": {
          "$ref": "#/$defs/Branch"
        },
        "app_sha256": {
          "$ref": "#/$defs/H"
        },
        "tests_sha256": {
          "$ref": "#/$defs/H"
        },
        "migrations_sha256": {
          "$ref": "#/$defs/H"
        },
        "support_sha256": {
          "$ref": "#/$defs/H"
        },
        "native_site_sha256": {
          "$ref": "#/$defs/H"
        },
        "versions_sha256": {
          "$ref": "#/$defs/H"
        },
        "prepared_cache_sha256": {
          "$ref": "#/$defs/H"
        },
        "policy_sha256": {
          "$ref": "#/$defs/H"
        },
        "controller_sha256": {
          "$ref": "#/$defs/H"
        },
        "image_digest": {
          "$ref": "#/$defs/Image"
